.accordion{margin-top:20px}.accordion-item{border:1px solid #e0ddd6;margin-bottom:-1px;background:var(--brand-white)}
.accordion-header{width:100%;padding:20px 24px;background:none;border:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-family:'Montserrat',sans-serif;font-size:15px;font-weight:700;color:var(--brand-text);text-align:left;transition:var(--transition)}
