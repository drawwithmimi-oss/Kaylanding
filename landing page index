<script>
// Generic carousel builder
function carousel(trackId, ddId, prevId, nextId, countId) {
  const slides = document.querySelectorAll('#'+trackId+' .c-slide');
  const dd = document.getElementById(ddId);
  const prev = document.getElementById(prevId);
  const next = document.getElementById(nextId);
  const count = document.getElementById(countId);
  let cur = 0; const tot = slides.length;
  function go(i) {
    cur = i;
    slides.forEach(s => s.classList.remove('active'));
    slides[cur].classList.add('active');
    dd.value = cur;
    prev.disabled = cur === 0;
    next.disabled = cur === tot - 1;
    count.textContent = (cur+1) + ' / ' + tot;
  }
  dd.addEventListener('change', () => go(parseInt(dd.value)));
  prev.addEventListener('click', () => { if (cur > 0) go(cur - 1); });
  next.addEventListener('click', () => { if (cur < tot - 1) go(cur + 1); });
  return { go, getCur: () => cur, tot };
}

const res = carousel('rTrack', 'rDD', 'rP', 'rN', 'rC');
const cs = carousel('csTrack', 'csDD', 'csP', 'csN', 'csC');

// Keyboard nav for case studies (default)
document.addEventListener('keydown', e => {
  if (e.key === 'ArrowLeft' && cs.getCur() > 0) cs.go(cs.getCur() - 1);
  if (e.key === 'ArrowRight' && cs.getCur() < cs.tot - 1) cs.go(cs.getCur() + 1);
});

// Accordions
document.querySelectorAll('.accordion-header').forEach(h => {
  h.addEventListener('click', () => {
    const b = h.nextElementSibling;
    const open = h.classList.contains('active');
    const acc = h.closest('.accordion');
    acc.querySelectorAll('.accordion-header').forEach(x => {
      x.classList.remove('active');
      x.nextElementSibling.style.maxHeight = null;
    });
    if (!open) {
      h.classList.add('active');
      b.style.maxHeight = b.scrollHeight + 'px';
    }
  });
});
</script>
