<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Stories That Connect Us | Lipp Studios</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400&family=Open+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>
:root{
  --brand-blue:#035787;
  --brand-burgundy:#5f0d23;
  --brand-dark:#141414;
  --brand-gold:#d6b13f;
  --brand-light:#f3f3f0;
  --brand-white:#ffffff;
  --brand-text:#1a1a1a;
  --brand-muted:#5f6368;
  --brand-teal:#1f6f78;
  --brand-crayon:#e8674a;
  --brand-crayon-light:rgba(232,103,74,0.18);
  --container:1180px;
  --shadow-soft:0 8px 24px rgba(0,0,0,0.08);
  --transition:0.3s ease
}
*{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth}
body{font-family:'Open Sans',Arial,Helvetica,sans-serif;color:var(--brand-text);background:var(--brand-white);line-height:1.7;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4,h5{font-family:'Montserrat','Arial Black',Helvetica,sans-serif;line-height:1.2}

/* ── BUTTONS ── */
.btn{display:inline-block;background:var(--brand-gold);color:var(--brand-text);font-family:'Montserrat',sans-serif;font-weight:700;font-size:14px;line-height:1;padding:14px 26px;border:1px solid #8c7420;text-decoration:none;box-shadow:2px 2px 0 rgba(0,0,0,0.15);transition:var(--transition);cursor:pointer;letter-spacing:0.02em}
.btn:hover{background:var(--brand-burgundy);color:var(--brand-white);border-color:var(--brand-burgundy)}
.btn-light{background:transparent;color:var(--brand-white);border:2px solid rgba(255,255,255,0.5);box-shadow:none}.btn-light:hover{background:var(--brand-white);color:var(--brand-dark);border-color:var(--brand-white)}
.btn-sm{padding:10px 18px;font-size:12px}
.btn-dark{background:var(--brand-dark);color:var(--brand-white);border-color:var(--brand-dark);box-shadow:none}.btn-dark:hover{background:var(--brand-blue);border-color:var(--brand-blue)}
.btn-outline{background:transparent;color:var(--brand-blue);border:1px solid var(--brand-blue);box-shadow:none}.btn-outline:hover{background:var(--brand-blue);color:var(--brand-white)}
.btn-crayon{background:var(--brand-crayon);color:var(--brand-white);border-color:var(--brand-crayon);box-shadow:none}.btn-crayon:hover{background:#c9543e;border-color:#c9543e}

/* ── CRAYON HIGHLIGHT ── */
.crayon-hl{position:relative;display:inline;padding:4px 10px;box-decoration-break:clone;-webkit-box-decoration-break:clone;background:url(data:image/svg+xml;base64,) center/calc(100% + 12px) calc(100% + 8px) no-repeat;margin:-2px -4px;border:none}
.crayon-hl-gold{background:url(data:image/svg+xml;base64,) center/calc(100% + 12px) calc(100% + 8px) no-repeat}
.crayon-hl-blue{background:url(data:image/svg+xml;base64,) center/calc(100% + 12px) calc(100% + 8px) no-repeat}
.crayon-hl-strong{background:url(data:image/svg+xml;base64,) center/calc(100% + 12px) calc(100% + 8px) no-repeat;color:var(--brand-white);padding:4px 10px}

/* ── CRAYON TEXTURE SEPARATOR ── */
.crayon-sep{display:block;width:100%;overflow:visible;line-height:0;margin:-2px 0;padding:0;position:relative;z-index:2}
.crayon-sep svg{display:block;width:100%;height:auto}

/* ── HEADER ── */
.header{position:fixed;top:0;left:0;right:0;z-index:100;background:var(--brand-dark);padding:0 24px;border-bottom:1px solid rgba(255,255,255,0.08)}
.header-inner{max-width:var(--container);margin:0 auto;display:flex;justify-content:space-between;align-items:center;height:64px}
.header-logo img{height:36px;display:block}
.header-nav{display:flex;gap:28px;align-items:center}
.header-nav a{text-decoration:none;color:rgba(255,255,255,0.7);font-size:13px;font-weight:600;letter-spacing:0.02em;transition:color 0.2s}.header-nav a:hover{color:var(--brand-gold)}
.header-nav .btn{padding:10px 20px;font-size:12px;box-shadow:none;border-color:var(--brand-gold)}

/* ── HERO ── */
.hero{position:relative;min-height:100vh;display:flex;align-items:center;padding:100px 24px 80px;background:var(--brand-dark);overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 20% 50%,rgba(3,87,135,0.15) 0%,transparent 60%),radial-gradient(ellipse at 80% 30%,rgba(95,13,35,0.1) 0%,transparent 50%);pointer-events:none}
.hero-inner{max-width:var(--container);margin:0 auto;display:grid;grid-template-columns:1.3fr 1fr;gap:60px;align-items:center;position:relative;z-index:1;width:100%}
.hero-eyebrow{display:inline-block;font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.14em;color:var(--brand-gold);margin-bottom:20px;padding-bottom:12px;border-bottom:2px solid var(--brand-gold)}
.hero h1{font-size:clamp(2.2rem,4.2vw,3.4rem);font-weight:900;color:var(--brand-gold);letter-spacing:-0.02em;margin-bottom:20px}
.hero h1 em{display:block;font-style:italic;font-weight:700;color:var(--brand-white);font-size:0.72em;margin-top:8px;letter-spacing:0}
.hero h1 .crayon-hl{background:rgba(232,103,74,0.3)}
.hero-text{font-size:16px;color:rgba(255,255,255,0.75);max-width:540px;margin-bottom:16px;line-height:1.75}
.hero-meta{display:flex;flex-wrap:wrap;gap:20px;font-size:13px;color:rgba(255,255,255,0.45);margin-bottom:32px}
.hero-actions{display:flex;gap:14px;flex-wrap:wrap}
.hero-card{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);padding:36px}
.hero-quote{font-family:'Montserrat',sans-serif;font-size:22px;font-weight:700;font-style:italic;color:var(--brand-white);line-height:1.5;margin-bottom:16px}
.hero-quote-attr{font-size:13px;color:var(--brand-gold);font-weight:600}
.hero-stats{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:28px}
.hero-stat{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.06);padding:16px;text-align:center}
.hero-stat .num{font-family:'Montserrat',sans-serif;font-size:28px;font-weight:900;color:var(--brand-gold)}
.hero-stat .label{font-size:11px;color:rgba(255,255,255,0.5);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;margin-top:2px}

/* ── GOLD / CRAYON STRIPS ── */
.gold-strip{background:var(--brand-gold);padding:20px 24px;text-align:center}
.gold-strip p{font-family:'Montserrat',sans-serif;font-size:15px;font-weight:700;color:var(--brand-dark);max-width:var(--container);margin:0 auto}

/* ── SECTIONS ── */
.section{padding:80px 24px}.section-dark{background:var(--brand-dark);color:var(--brand-white)}.section-light{background:var(--brand-light)}.section-white{background:var(--brand-white)}
.section-inner{max-width:var(--container);margin:0 auto}
.eyebrow{font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.14em;color:var(--brand-blue);margin-bottom:10px}
.section-dark .eyebrow{color:var(--brand-gold)}
.section-title{font-size:clamp(26px,3vw,36px);font-weight:800;color:var(--brand-text);letter-spacing:-0.02em;margin-bottom:12px}.section-dark .section-title{color:var(--brand-white)}
.section-subtitle{font-size:16px;color:var(--brand-muted);max-width:640px;margin-bottom:48px;line-height:1.75}.section-dark .section-subtitle{color:rgba(255,255,255,0.6)}

/* ── NEXT SESSION ── */
.next-session{background:var(--brand-white);border:2px solid var(--brand-blue);padding:28px 32px;display:grid;grid-template-columns:auto 1fr auto;gap:28px;align-items:center;margin-bottom:48px;box-shadow:var(--shadow-soft)}
.next-session-date{text-align:center;background:var(--brand-dark);padding:16px 20px;min-width:90px}
.next-session-date .month{font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--brand-gold)}
.next-session-date .day{font-family:'Montserrat',sans-serif;font-size:32px;font-weight:900;color:var(--brand-white);line-height:1.1}
.next-session-date .year{font-size:12px;color:rgba(255,255,255,0.5)}
.next-session-info h3{font-size:17px;font-weight:700;color:var(--brand-text);margin-bottom:4px}
.next-session-info p{font-size:14px;color:var(--brand-muted)}

/* ── SHARED CAROUSEL ── */
.c-controls{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px}
.c-nav{display:flex;gap:8px;align-items:center}
.c-arrow{width:40px;height:40px;background:var(--brand-dark);color:var(--brand-white);border:none;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:var(--transition);font-family:'Montserrat',sans-serif;font-weight:700}
.c-arrow:hover{background:var(--brand-blue)}.c-arrow:disabled{opacity:0.3;cursor:default;background:var(--brand-dark)}
.c-count{font-family:'Montserrat',sans-serif;font-size:12px;font-weight:600;color:var(--brand-muted);margin:0 8px}
.c-dropdown{font-family:'Montserrat',sans-serif;font-size:13px;font-weight:600;padding:10px 40px 10px 16px;border:1px solid #e0ddd6;background:var(--brand-white) url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%235f6368' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E") no-repeat right 14px center;color:var(--brand-text);cursor:pointer;min-width:280px;appearance:none;-webkit-appearance:none}
.c-track{overflow:hidden}.c-slide{display:none;animation:fadeIn .35s ease}.c-slide.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* ── RESOURCE SLIDES ── */
.res-slide.active{display:grid;grid-template-columns:400px 1fr;border:1px solid #e0ddd6;background:var(--brand-white)}
.res-img{background:var(--brand-light);display:flex;align-items:center;justify-content:center;border-right:1px solid #e0ddd6;position:relative}
.res-img .type-tag{position:absolute;top:16px;left:16px;font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--brand-white);background:var(--brand-dark);padding:5px 12px}
.res-img .placeholder{width:120px;height:120px}
.res-body{padding:40px;display:flex;flex-direction:column;justify-content:center}
.res-body .meta{font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--brand-blue);padding:4px 10px;background:rgba(3,87,135,.07);display:inline-block;margin-bottom:16px}
.res-body h3{font-size:20px;font-weight:800;color:var(--brand-text);margin-bottom:10px}
.res-body p{font-size:15px;color:var(--brand-muted);line-height:1.75;margin-bottom:16px}
.res-actions{display:flex;gap:10px;flex-wrap:wrap}

/* ── CASE STUDY SLIDES ── */
.cs-layout{display:grid;grid-template-columns:340px 1fr;border:1px solid #e0ddd6;background:var(--brand-white)}
.cs-vis{padding:48px 32px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;position:relative}
.cs-vis.bg-dark{background:var(--brand-dark)}.cs-vis.bg-blue{background:var(--brand-blue)}.cs-vis.bg-burgundy{background:var(--brand-burgundy)}.cs-vis.bg-teal{background:var(--brand-teal)}.cs-vis.bg-gold{background:#8c7420}
.cs-vis .med-tag{position:absolute;top:16px;left:16px;background:rgba(255,255,255,.15);padding:4px 10px;font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;color:white;text-transform:uppercase;letter-spacing:.08em}
.cs-vis .img-ph{width:160px;height:160px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);margin-bottom:24px}
.cs-vis h3{font-size:22px;font-weight:800;color:white;line-height:1.3;margin-bottom:6px}
.cs-vis .cl{font-size:12px;color:rgba(255,255,255,.6);font-weight:500}
.cs-body{padding:40px}
.cs-body h4{font-size:18px;font-weight:700;color:var(--brand-text);margin-bottom:12px}
.cs-body p{font-size:14px;color:var(--brand-muted);margin-bottom:12px;line-height:1.7}
.cs-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}
.cs-tag{font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;padding:4px 10px;border:1px solid #e0ddd6;color:var(--brand-muted);text-transform:uppercase;letter-spacing:.04em}
.cs-impact{margin-top:20px;padding-top:16px;border-top:1px solid #e0ddd6}
.cs-impact .il{font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--brand-blue);margin-bottom:6px}
.cs-impact p{margin-bottom:0}
.cs-links{margin-top:16px;display:flex;gap:10px;flex-wrap:wrap}

/* ── STORY SPLIT ── */
.story-split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.story-img{aspect-ratio:1;background:var(--brand-light);border:1px solid #e0ddd6;display:flex;align-items:center;justify-content:center}
.story-img .placeholder{width:120px;height:120px;background:#ddd8ce}
.story-copy h2{font-size:28px;font-weight:800;color:var(--brand-text);margin-bottom:16px}
.story-copy p{font-size:15px;color:var(--brand-muted);line-height:1.75;margin-bottom:14px}
.story-copy .qi{font-family:'Montserrat',sans-serif;font-size:16px;font-weight:700;font-style:italic;color:var(--brand-blue);border-left:3px solid var(--brand-gold);padding-left:16px;margin:20px 0}

/* ── ACCORDION ── */
.accordion{margin-top:20px}.accordion-item{border:1px solid #e0ddd6;margin-bottom:-1px;background:var(--brand-white)}
.accordion-header{width:100%;padding:20px 24px;background:none;border:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-family:'Montserrat',sans-serif;font-size:15px;font-weight:700;color:var(--brand-text);text-align:left;transition:var(--transition)}
.accordion-header:hover{background:var(--brand-light)}.accordion-header.active{background:var(--brand-light);color:var(--brand-blue)}
.ai-icon{font-size:20px;font-weight:400;transition:transform .3s;color:var(--brand-muted);flex-shrink:0;margin-left:16px}
.accordion-header.active .ai-icon{transform:rotate(45deg);color:var(--brand-blue)}
.accordion-body{max-height:0;overflow:hidden;transition:max-height .4s ease}
.abi{padding:0 24px 24px}.abi p{font-size:14px;color:var(--brand-muted);line-height:1.75;margin-bottom:12px}.abi p:last-child{margin-bottom:0}
.section-dark .accordion-item{border-color:rgba(255,255,255,.1);background:rgba(255,255,255,.03)}
.section-dark .accordion-header{color:var(--brand-white)}.section-dark .accordion-header:hover{background:rgba(255,255,255,.05)}
.section-dark .accordion-header.active{background:rgba(255,255,255,.06);color:var(--brand-gold)}.section-dark .accordion-header.active .ai-icon{color:var(--brand-gold)}
.section-dark .abi p{color:rgba(255,255,255,.6)}

/* ── PROOF GRID ── */
.proof-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.proof-card{background:var(--brand-white);border:1px solid #e0ddd6;padding:28px}
.proof-card h3{font-size:14px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--brand-blue);margin-bottom:12px}
.proof-card p{font-size:14px;color:var(--brand-muted);line-height:1.7}
.word-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.wt{font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;padding:6px 12px;background:rgba(3,87,135,.06);color:var(--brand-blue)}
.wt.hl{background:var(--brand-gold);color:var(--brand-dark)}

/* ── FRAMEWORK VISUAL ── */
.fw-visual{display:grid;grid-template-columns:1fr auto 1fr;gap:0;align-items:stretch;margin:40px 0}
.fw-col{background:var(--brand-white);padding:28px;border:1px solid #e0ddd6}
.fw-col h3{font-size:16px;font-weight:800;margin-bottom:4px}
.fw-col .sub{font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:16px}
.fw-col ul{list-style:none}.fw-col li{font-size:14px;color:var(--brand-muted);padding:5px 0 5px 16px;position:relative}
.fw-col li::before{content:'';position:absolute;left:0;top:12px;width:6px;height:6px}
.fw-col.k h3,.fw-col.k .sub{color:var(--brand-blue)}.fw-col.k li::before{background:var(--brand-blue)}
.fw-col.o h3,.fw-col.o .sub{color:var(--brand-burgundy)}.fw-col.o li::before{background:var(--brand-burgundy)}
.fw-bridge{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 24px}
.fw-bridge .arr{font-size:24px;color:var(--brand-gold)}
.fw-bridge .lbl{writing-mode:vertical-lr;font-family:'Montserrat',sans-serif;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--brand-gold);margin:12px 0}
.fw-med{text-align:center;margin-top:20px;background:var(--brand-dark);padding:20px 32px}
.fw-med .la{font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--brand-gold);margin-bottom:6px}
.fw-med p{font-size:14px;color:rgba(255,255,255,.7)}

/* ── TEAL STRIP ── */
.teal-strip{background:var(--brand-teal);padding:16px 24px}
.teal-strip h2{max-width:var(--container);margin:0 auto;font-size:20px;font-weight:800;color:var(--brand-white);text-transform:uppercase;letter-spacing:.04em}

/* ── PRINCIPLES ── */
.principles-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}
.pc{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);padding:28px;border-top:3px solid var(--brand-gold)}
.pc h3{font-size:15px;font-weight:700;color:var(--brand-white);margin-bottom:8px}
.pc p{font-size:14px;color:rgba(255,255,255,.6);line-height:1.65}

/* ── TESTIMONIAL ── */
.testimonial-card{max-width:780px;margin:0 auto;text-align:center}
.testimonial-card blockquote{font-size:20px;font-weight:600;font-style:italic;color:var(--brand-text);line-height:1.65;margin-bottom:20px}
.testimonial-card cite{font-style:normal;font-size:14px;color:var(--brand-muted);font-weight:600}

/* ── CREW ── */
.crew-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px}
.crew-card{text-align:center;padding:28px 20px;background:var(--brand-white);border:1px solid #e0ddd6;transition:var(--transition)}
.crew-card:hover{box-shadow:var(--shadow-soft);transform:translateY(-3px)}
.crew-avatar{width:80px;height:80px;margin:0 auto 14px;display:flex;align-items:center;justify-content:center;font-family:'Montserrat',sans-serif;font-size:22px;font-weight:900;color:white}
.crew-card:nth-child(1) .crew-avatar{background:var(--brand-dark)}.crew-card:nth-child(2) .crew-avatar{background:var(--brand-blue)}.crew-card:nth-child(3) .crew-avatar{background:var(--brand-burgundy)}.crew-card:nth-child(4) .crew-avatar{background:var(--brand-teal)}.crew-card:nth-child(5) .crew-avatar{background:var(--brand-muted)}
.crew-card h3{font-size:15px;font-weight:700;color:var(--brand-text);margin-bottom:2px}
.crew-card .pr{font-size:12px;color:var(--brand-muted);margin-bottom:4px}
.crew-card .ro{font-size:13px;color:var(--brand-blue);font-weight:600}

/* ── CTA ── */
.cta-section{background:var(--brand-dark);padding:100px 24px;text-align:center;position:relative;overflow:hidden}
.cta-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at center,rgba(3,87,135,.12) 0%,transparent 60%);pointer-events:none}
.cta-inner{max-width:700px;margin:0 auto;position:relative;z-index:1}
.cta-section h2{font-size:clamp(28px,3.5vw,40px);font-weight:900;color:var(--brand-gold);margin-bottom:16px;letter-spacing:-.02em}
.cta-section p{font-size:16px;color:rgba(255,255,255,.6);margin-bottom:36px;line-height:1.75}

/* ── FOOTER ── */
.footer{background:var(--brand-dark);padding:32px 24px;border-top:1px solid rgba(255,255,255,.06);text-align:center}
.footer p{font-size:13px;color:rgba(255,255,255,.4)}.footer a{color:var(--brand-gold);text-decoration:none}.footer a:hover{text-decoration:underline}


/* ═══════════════════════════════════════════
   NEW SECTIONS — KAY'S FEEDBACK
   ═══════════════════════════════════════════ */

/* ── LOGO / PARTNER GRID ── */
.logo-section{padding:60px 24px;background:var(--brand-white)}
.logo-section-inner{max-width:var(--container);margin:0 auto;text-align:center}
.logo-section h2{font-family:'Montserrat',sans-serif;font-size:22px;font-weight:900;text-transform:uppercase;letter-spacing:.04em;color:var(--brand-text);margin-bottom:8px}
.logo-section h2 .crayon-hl{padding:2px 8px}
.logo-section .logo-sub{font-size:14px;color:var(--brand-muted);margin-bottom:36px}
.logo-grid{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:28px 40px;max-width:900px;margin:0 auto}
.logo-grid img{height:48px;width:auto;opacity:.75;transition:opacity .3s;object-fit:contain}
.logo-grid img:hover{opacity:1}
.logo-grid img.logo-wide{height:36px}

/* ── RESOURCES / MEDIA KIT ── */
.media-section{padding:80px 24px;background:var(--brand-light)}
.media-inner{max-width:var(--container);margin:0 auto;text-align:center}
.media-inner h2{font-family:'Montserrat',sans-serif;font-size:28px;font-weight:900;color:var(--brand-text);margin-bottom:4px}
.media-inner .media-sub-label{font-family:'Montserrat',sans-serif;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--brand-muted);margin-bottom:36px}
.headshot-grid{display:flex;justify-content:center;gap:20px;flex-wrap:wrap;margin-bottom:40px}
.headshot-grid .hs{width:160px;height:200px;background:var(--brand-white);border:1px solid #e0ddd6;display:flex;align-items:center;justify-content:center;overflow:hidden;transition:var(--transition)}
.headshot-grid .hs:hover{box-shadow:var(--shadow-soft);transform:translateY(-3px)}
.headshot-grid .hs img{width:100%;height:100%;object-fit:cover}
.headshot-grid .hs .hs-ph{width:60px;height:60px;background:#ddd8ce;border-radius:50%}
.media-btns{display:flex;justify-content:center;gap:16px;flex-wrap:wrap}
.media-btns .btn{min-width:220px;text-align:center}

/* ── KEYNOTE HYBRID SECTION ── */
.keynote-section{padding:80px 24px;background:var(--brand-white)}
.keynote-inner{max-width:var(--container);margin:0 auto}
.keynote-header{text-align:center;margin-bottom:48px}
.keynote-header h2{font-size:clamp(28px,3.5vw,42px);font-weight:900;color:var(--brand-text);margin-bottom:12px}
.keynote-header p{font-size:16px;color:var(--brand-muted);max-width:640px;margin:0 auto;line-height:1.75}

.keynote-overview{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;margin-bottom:56px}
.keynote-desc h3{font-size:22px;font-weight:800;color:var(--brand-text);margin-bottom:16px}
.keynote-desc p{font-size:15px;color:var(--brand-muted);line-height:1.75;margin-bottom:14px}
.keynote-desc .qi{font-family:'Montserrat',sans-serif;font-size:16px;font-weight:700;font-style:italic;color:var(--brand-blue);border-left:3px solid var(--brand-crayon);padding-left:16px;margin:20px 0}
.keynote-meta-card{background:var(--brand-dark);padding:36px;color:white}
.keynote-meta-card h4{font-family:'Montserrat',sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--brand-gold);margin-bottom:20px}
.kmc-item{padding:12px 0;border-bottom:1px solid rgba(255,255,255,.08)}
.kmc-item:last-child{border-bottom:none}
.kmc-item .kmc-label{font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--brand-gold);margin-bottom:2px}
.kmc-item .kmc-val{font-size:14px;color:rgba(255,255,255,.75)}

/* Audience tabs */
.aud-tabs-label{font-family:'Montserrat',sans-serif;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--brand-blue);margin-bottom:16px}
.aud-tabs{display:flex;gap:0;flex-wrap:wrap;margin-bottom:0}
.aud-tab{font-family:'Montserrat',sans-serif;font-size:13px;font-weight:700;padding:14px 24px;border:1px solid #e0ddd6;border-bottom:none;background:var(--brand-light);color:var(--brand-muted);cursor:pointer;transition:var(--transition);position:relative}
.aud-tab:hover{background:var(--brand-white);color:var(--brand-text)}
.aud-tab.active{background:var(--brand-white);color:var(--brand-text);border-bottom-color:var(--brand-white);z-index:2}
.aud-tab.active::after{content:'';position:absolute;bottom:-1px;left:0;right:0;height:2px;background:var(--brand-white)}

/* Audience panels — Dorie Clark style with colored left border */
.aud-panels{border:1px solid #e0ddd6;background:var(--brand-white)}
.aud-panel{display:none;padding:40px;animation:fadeIn .35s ease}
.aud-panel.active{display:block}
.aud-panel-inner{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}
.aud-left{border-left:5px solid var(--brand-crayon);padding-left:24px}
.aud-left h3{font-size:20px;font-weight:800;color:var(--brand-text);margin-bottom:8px}
.aud-left .aud-subtitle{font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--brand-crayon);margin-bottom:16px}
.aud-left p{font-size:15px;color:var(--brand-muted);line-height:1.75;margin-bottom:12px}
.aud-right h4{font-family:'Montserrat',sans-serif;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--brand-blue);margin-bottom:14px}
.aud-takeaways{list-style:none;margin-bottom:24px}
.aud-takeaways li{font-size:14px;color:var(--brand-muted);padding:8px 0 8px 20px;position:relative;line-height:1.6;border-bottom:1px solid #f0ede8}
.aud-takeaways li::before{content:'';position:absolute;left:0;top:14px;width:8px;height:8px;background:var(--brand-gold)}
.aud-testimonial{background:var(--brand-light);padding:20px;margin-bottom:20px;border-left:3px solid var(--brand-gold)}
.aud-testimonial blockquote{font-size:14px;font-style:italic;color:var(--brand-text);line-height:1.65;margin-bottom:8px}
.aud-testimonial cite{font-size:12px;color:var(--brand-muted);font-style:normal;font-weight:600}

/* Color variants for each audience tab panel */
.aud-panel[data-audience="workplace"] .aud-left{border-left-color:var(--brand-blue)}
.aud-panel[data-audience="workplace"] .aud-left .aud-subtitle{color:var(--brand-blue)}
.aud-panel[data-audience="schools"] .aud-left{border-left-color:var(--brand-teal)}
.aud-panel[data-audience="schools"] .aud-left .aud-subtitle{color:var(--brand-teal)}
.aud-panel[data-audience="healthcare"] .aud-left{border-left-color:var(--brand-crayon)}
.aud-panel[data-audience="healthcare"] .aud-left .aud-subtitle{color:var(--brand-crayon)}
.aud-panel[data-audience="youth"] .aud-left{border-left-color:var(--brand-gold)}
.aud-panel[data-audience="youth"] .aud-left .aud-subtitle{color:#8c7420}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .hero-inner{grid-template-columns:1fr}.hero-card{display:none}.header-nav{display:none}
  .cs-layout{grid-template-columns:1fr}.res-slide.active{grid-template-columns:1fr}
  .res-img{aspect-ratio:16/10;border-right:none;border-bottom:1px solid #e0ddd6}
  .fw-visual{grid-template-columns:1fr;gap:12px}.fw-bridge{flex-direction:row;padding:8px 0}.fw-bridge .lbl{writing-mode:horizontal-tb}
  .next-session{grid-template-columns:1fr;text-align:center}.story-split{grid-template-columns:1fr}.proof-grid{grid-template-columns:1fr}
  .c-dropdown{min-width:auto;width:100%}
  .keynote-overview{grid-template-columns:1fr}
  .aud-panel-inner{grid-template-columns:1fr}
  .aud-tabs{flex-direction:column}.aud-tab{border-bottom:1px solid #e0ddd6}
  .aud-tab.active::after{display:none}
  .headshot-grid .hs{width:120px;height:150px}
}
</style>
